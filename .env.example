# --- YouCam / Perfect Corp -------------------------------------------------
# Required. The try-on and the skin scan are live API calls; without a key the
# app tells you so on the scanning screen rather than failing silently.
EXPO_PUBLIC_YOUCAM_API_KEY=sk-your-youcam-api-key
EXPO_PUBLIC_YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# Optional. Caps estimated units per app session (default 400) and throws before
# creating a task rather than after, so an exhausted budget costs nothing.
# This guard exists because an uncapped retry loop once burned ~1000 units.
EXPO_PUBLIC_YOUCAM_UNIT_BUDGET=400

# --- Supabase (optional) ---------------------------------------------------
# Telemetry only. Leave both blank and the app runs fine — swipes simply are not
# synced, and the brand console has nothing to show.
#
# Use the ANON / publishable key. NEVER the service-role key: it bypasses row
# level security entirely, so shipping it in a mobile bundle hands full read and
# write on the database to anyone who unzips the APK.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
