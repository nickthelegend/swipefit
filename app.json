{
  "expo": {
    "name": "SwipeFit",
    "slug": "swipefit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "swipefit",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swipefit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FA9DCD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.swipefit.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "SWIPEFIT uses your camera to photograph you for the skin scan and the virtual try-on."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SWIPEFIT uses your photo library so you can pick a photo for the skin scan and the virtual try-on."
        }
      ],
      "expo-asset",
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
